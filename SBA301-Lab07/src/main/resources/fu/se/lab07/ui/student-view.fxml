<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fu.se.lab07.ui.controller.StudentController"
            prefHeight="680.0" prefWidth="850.0"
            stylesheets="@styles.css">

    <!-- Top: Header Banner -->
    <top>
        <VBox styleClass="header-box" spacing="4.0">
            <Label text="Library Department - Student Management" styleClass="header-title"/>
            <Label text="SBA301 Lab 07 • JavaFX + Hibernate ORM • Repository Pattern" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- Center: Form & Table -->
    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets top="16.0" right="20.0" bottom="16.0" left="20.0"/>
            </padding>

            <!-- Card 1: Input Form -->
            <VBox styleClass="card" spacing="12.0">
                <Label text="Student Information" styleClass="card-title"/>
                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100.0" prefWidth="110.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
                        <ColumnConstraints minWidth="100.0" prefWidth="110.0"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
                    </columnConstraints>

                    <!-- Row 0: Email & Password -->
                    <Label text="Email:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtEmail" promptText="e.g. student@fpt.edu.vn" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Password:" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <PasswordField fx:id="txtPassword" promptText="Enter password" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <!-- Row 1: First Name & Last Name -->
                    <Label text="First Name:" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtFirstName" promptText="e.g. John" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="Last Name:" styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtLastName" promptText="e.g. Doe" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <!-- Row 2: Marks -->
                    <Label text="Marks (0 - 10):" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtMarks" promptText="e.g. 8.5" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>

                <!-- Action Buttons -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="6.0"/>
                    </padding>
                    <Button text="Add Student" onAction="#handleCreate" styleClass="btn, btn-primary"/>
                    <Button text="Update Student" onAction="#handleUpdate" styleClass="btn, btn-warning"/>
                    <Button text="Delete Student" onAction="#handleDelete" styleClass="btn, btn-danger"/>
                    <Button text="Clear Form" onAction="#handleClear" styleClass="btn, btn-secondary"/>
                </HBox>
            </VBox>

            <!-- Card 2: TableView -->
            <VBox styleClass="card" spacing="8.0" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Student List" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblRecordCount" text="Total: 0 students" style="-fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                </HBox>

                <TableView fx:id="tblStudents" VBox.vgrow="ALWAYS" prefHeight="300.0">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60.0"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="220.0"/>
                        <TableColumn fx:id="colFirstName" text="First Name" prefWidth="150.0"/>
                        <TableColumn fx:id="colLastName" text="Last Name" prefWidth="150.0"/>
                        <TableColumn fx:id="colMarks" text="Marks" prefWidth="90.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>

</BorderPane>
