<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fu.se.lab07.ui.controller.LoginController"
      alignment="CENTER" spacing="16.0"
      prefHeight="400.0" prefWidth="420.0"
      stylesheets="@styles.css"
      style="-fx-background-color: #f4f6f9;">

    <padding>
        <Insets top="30.0" right="36.0" bottom="30.0" left="36.0"/>
    </padding>

    <!-- Card Container -->
    <VBox styleClass="card" spacing="16.0" alignment="CENTER" maxWidth="380.0">
        <!-- Title & Subtitle -->
        <VBox alignment="CENTER" spacing="4.0">
            <Label text="LOGIN FORM" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e3c72;"/>
            <Label text="Library Management System" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
        </VBox>

        <!-- Form fields -->
        <VBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Email Address:" styleClass="form-label"/>
            <TextField fx:id="txtEmail" promptText="Enter your email" text="admin@fpt.edu.vn"/>

            <Label text="Password:" styleClass="form-label"/>
            <PasswordField fx:id="txtPassword" promptText="Enter your password" text="123456"/>
        </VBox>

        <!-- Action buttons -->
        <HBox spacing="12.0" alignment="CENTER">
            <padding>
                <Insets top="8.0"/>
            </padding>
            <Button text="Login" onAction="#handleLogin" styleClass="btn, btn-primary" prefWidth="120.0" defaultButton="true"/>
            <Button text="Cancel" onAction="#handleCancel" styleClass="btn, btn-secondary" prefWidth="120.0" cancelButton="true"/>
        </HBox>
    </VBox>

</VBox>
