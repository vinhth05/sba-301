            "method": "GET",
            "url": "http://localhost:8080/api/news-articles/public/active"
          }
        },
        {
          "name": "Search News Articles (Filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/news-articles?keyword=Alumni&categoryId=4&status=true",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "news-articles"],
              "query": [
                { "key": "keyword", "value": "Alumni" },
                { "key": "categoryId", "value": "4" },
                { "key": "status", "value": "true" }
              ]
            }
