            "url": {
              "raw": "{{baseUrl}}/rooms/3",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "3"]
            }
          }
        },
        {
          "name": "4.4 Business Rule: Delete Unrented Room -> Hard Deleted",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms/9",
