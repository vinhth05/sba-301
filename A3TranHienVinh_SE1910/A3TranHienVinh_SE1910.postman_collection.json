          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{staffToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/2/status?status=0",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "2", "status"],
              "query": [
